#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>
#include <winver.h>
#include "d2r_vr_version.h"   // made from vrcam.cpp's g_info_version by tools/settings/version.cmake

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

// Who this DLL is, for the shared VR mod launcher and for a support log: D2R VR (BodyWalkVR), not d2r-pcvr, which is a fork of
// our 0.152 and carries the same plugin id, name and author. D2RLoader reads the manifest above, not this block.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION D2RVR_VERSION_RC
 PRODUCTVERSION D2RVR_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BodyWalkVR"
            VALUE "FileDescription", "D2R VR - the VR layer (a D2RLoader plugin)"
            VALUE "FileVersion", D2RVR_VERSION
            VALUE "InternalName", D2RVR_MOD_ID
            VALUE "LegalCopyright", "Copyright (c) 2026 BodyWalkVR. MIT licence."
            VALUE "OriginalFilename", "d2rl-vrcam.dll"
            VALUE "ProductName", "D2R VR"
            VALUE "ProductVersion", D2RVR_VERSION
            VALUE "Comments", D2RVR_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
