#include <winver.h>
#include "d2r_vr_version.h"   // made from vrcam.cpp's g_info_version by tools/settings/version.cmake

// The program's icon: tools/gen_icon.py
1 ICON "d2r_vr.ico"

// Who this program is, for the shared VR mod launcher and for a support log (the same product, version and mod id as the plugin's).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION D2RVR_VERSION_RC
 PRODUCTVERSION D2RVR_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "natpoh"
            VALUE "FileDescription", "D2R VR Authentic Settings"
            VALUE "FileVersion", D2RVR_VERSION
            VALUE "InternalName", "d2r-vr-settings"
            VALUE "LegalCopyright", "Copyright (c) 2026 natpoh. MIT licence."
            VALUE "OriginalFilename", "D2R_VR_Settings.exe"
            VALUE "ProductName", "D2R VR"
            VALUE "ProductVersion", D2RVR_VERSION
            VALUE "Comments", D2RVR_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
